+      const r = parseDateOfBirth(v);
+      assert.equal(r.invalid, true, `expected invalid: ${String(v)}`);
+      assert.equal(r.date, null);
+    }
+  });
+
+  test("SheetJS xlsx date cells round-trip as the same calendar day", () => {
