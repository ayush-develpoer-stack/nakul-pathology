# ==========================================
# SERVER
# ==========================================
PORT=5000
NODE_ENV=development

# ==========================================
# DATABASE
# ==========================================
# e.g. mongodb+srv://<user>:<password>@<cluster>/<db>  (never commit a real one)
MONGODB_URI=

# ==========================================
# AUTHENTICATION
# ==========================================
# Use long random values (min 32 chars in production), e.g.
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_SECRET=

# ==========================================
# FRONTEND / CRM ORIGINS (comma separated allowed for CORS)
# ==========================================
CLIENT_URL=http://localhost:3000
CRM_URL=http://localhost:5173

# ==========================================
# CLOUDINARY (reports, prescriptions, documents)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# WHATSAPP — PROVIDER SELECTION + KILL SWITCH
# ==========================================
# WHATSAPP_PROVIDER selects the active outbound provider: "meta" | "twilio" | "msg91".
# Only the selected provider ever sends (with msg91 selected, Twilio refuses).
# WHATSAPP_SENDING_ENABLED is the provider-agnostic kill switch. Leave it
# false until you deliberately want to send real messages.
WHATSAPP_PROVIDER=meta
WHATSAPP_SENDING_ENABLED=false

# ==========================================
# META WHATSAPP CLOUD API
# ==========================================
# Webhook is LIVE at: /api/v1/whatsapp/webhook (GET verify + POST events).
# META_WHATSAPP_VERIFY_TOKEN must match the token entered in the Meta App
# dashboard webhook configuration. Outbound sending stays gated by
# WHATSAPP_SENDING_ENABLED (leave false until ready to send real messages).
# NEVER expose META_WHATSAPP_ACCESS_TOKEN or META_WHATSAPP_VERIFY_TOKEN to
# the frontend — they are backend-only secrets.
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=

# ==========================================
# TWILIO WHATSAPP (trial / test integration)
# ==========================================
# Backend-only secrets. NEVER expose these to the frontend or commit values.
# TWILIO_WHATSAPP_FROM: the Twilio WhatsApp number messages are sent FROM,
#   as whatsapp:+<E.164>. Sandbox: the number shown in Console → Messaging →
#   Try it out → Send a WhatsApp message (differs per account). Production:
#   an approved sender from Console → Messaging → Senders → WhatsApp senders.
#   Never your own/test phone (that belongs in WHATSAPP_TEST_ALLOWLIST).
#   Either this or TWILIO_MESSAGING_SERVICE_SID (MG...) is required.
# TWILIO_WHATSAPP_SANDBOX: "true" when TWILIO_WHATSAPP_FROM is the Sandbox
#   number, "false" for an approved production sender.
# TWILIO_WEBHOOK_URL / TWILIO_STATUS_CALLBACK_URL must EXACTLY match the URLs
#   configured in Twilio Console (used for X-Twilio-Signature validation):
#   https://<api-domain>/api/v1/whatsapp/twilio/webhook
#   https://<api-domain>/api/v1/whatsapp/twilio/status
# TWILIO_TEST_CONTENT_SID: optional approved Content template (HX...) used by
#   the admin test-send endpoint when sending a template instead of free text.
#   On a Twilio TRIAL account this is the only way to send outbound (free text
#   fails with 21654): copy the ContentSid from the code sample on Console →
#   Messaging → Try it out → Send a WhatsApp message.
# WHATSAPP_TEST_ALLOWLIST: comma-separated test recipients (10-digit Indian
#   mobile or +91...). Test-send only ever goes to these numbers.
# WHATSAPP_RESTRICT_TO_ALLOWLIST: while true (default), CRM replies and
#   campaign messages are ALSO limited to WHATSAPP_TEST_ALLOWLIST. Set to
#   exactly "false" only once a production WhatsApp sender is live.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_SANDBOX=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_WEBHOOK_URL=
TWILIO_TEST_CONTENT_SID=
WHATSAPP_TEST_ALLOWLIST=
WHATSAPP_RESTRICT_TO_ALLOWLIST=true

# ==========================================
# MSG91 WHATSAPP (WHATSAPP_PROVIDER=msg91)
# ==========================================
# Backend-only secrets. NEVER expose these to the frontend or commit values.
# MSG91_AUTH_KEY: MSG91 panel → Authkey (sent as the `authkey` header).
# MSG91_WHATSAPP_NUMBER: the integrated WhatsApp SENDER number exactly as
#   MSG91 → WhatsApp → Numbers shows it, with country code, digits only
#   (e.g. 91XXXXXXXXXX). Never your personal test phone — that goes in
#   WHATSAPP_TEST_ALLOWLIST. No WABA ID / integration ID is needed by the API.
# MSG91_WEBHOOK_SECRET: a long random value (e.g. 32+ chars). Add it in
#   MSG91 → WhatsApp → Webhook (New) as a custom header on BOTH webhooks:
#     X-Webhook-Secret: <this value>
#   Inbound:  https://<api-domain>/api/v1/whatsapp/msg91/inbound  (On Inbound Request Received)
#   Reports:  https://<api-domain>/api/v1/whatsapp/msg91/status   (On Outbound Report Received)
# Test sends (Settings → WhatsApp) only go to WHATSAPP_TEST_ALLOWLIST and only
# while WHATSAPP_SENDING_ENABLED=true. Campaigns never run through MSG91.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_NUMBER=
MSG91_WEBHOOK_SECRET=

# ==========================================
# WHATSAPP CAMPAIGNS (background worker)
# ==========================================
# The worker runs inside the web process (no Redis/queue service needed) and
# only sends while ALL of these hold: WHATSAPP_CAMPAIGNS_ENABLED=true,
# WHATSAPP_SENDING_ENABLED=true, WHATSAPP_PROVIDER=twilio, Twilio configured.
# Campaigns pause while the instance sleeps and resume when it wakes; use an
# always-on instance for scheduled campaigns.
# WHATSAPP_CAMPAIGN_MAX_PER_MINUTE: send rate per instance (1-600, default 20).
# WHATSAPP_CAMPAIGN_MAX_RECIPIENTS: per-campaign recipient cap (1-20000, default 1000).
WHATSAPP_CAMPAIGNS_ENABLED=false
WHATSAPP_CAMPAIGN_MAX_PER_MINUTE=20
WHATSAPP_CAMPAIGN_MAX_RECIPIENTS=1000

# (SMTP_* removed: no code sends email and nodemailer was uninstalled.
#  Leftover SMTP_* lines in an existing .env are ignored.)

# ==========================================
# SEED ADMIN (used only by npm run seed:admin)
# ==========================================
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PHONE=
SEED_ADMIN_PASSWORD=

# ==========================================
# RATE LIMITING
# ==========================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
PUBLIC_RATE_LIMIT_MAX_REQUESTS=60

