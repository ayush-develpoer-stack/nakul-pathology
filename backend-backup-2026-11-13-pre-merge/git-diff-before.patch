index cfa1fe7..17ac84f 100644
--- a/.env.example
+++ b/.env.example
@@ -35,7 +35,8 @@ CLOUDINARY_API_SECRET=
 # ==========================================
 # WHATSAPP — PROVIDER SELECTION + KILL SWITCH
 # ==========================================
-# WHATSAPP_PROVIDER selects the active outbound provider: "meta" | "twilio".
+# WHATSAPP_PROVIDER selects the active outbound provider: "meta" | "twilio" | "msg91".
+# Only the selected provider ever sends (with msg91 selected, Twilio refuses).
 # WHATSAPP_SENDING_ENABLED is the provider-agnostic kill switch. Leave it
 # false until you deliberately want to send real messages.
 WHATSAPP_PROVIDER=meta
@@ -92,6 +93,26 @@ TWILIO_TEST_CONTENT_SID=
 WHATSAPP_TEST_ALLOWLIST=
 WHATSAPP_RESTRICT_TO_ALLOWLIST=true
 
+# ==========================================
+# MSG91 WHATSAPP (WHATSAPP_PROVIDER=msg91)
+# ==========================================
+# Backend-only secrets. NEVER expose these to the frontend or commit values.
+# MSG91_AUTH_KEY: MSG91 panel → Authkey (sent as the `authkey` header).
+# MSG91_WHATSAPP_NUMBER: the integrated WhatsApp SENDER number exactly as
+#   MSG91 → WhatsApp → Numbers shows it, with country code, digits only
+#   (e.g. 91XXXXXXXXXX). Never your personal test phone — that goes in
+#   WHATSAPP_TEST_ALLOWLIST. No WABA ID / integration ID is needed by the API.
+# MSG91_WEBHOOK_SECRET: a long random value (e.g. 32+ chars). Add it in
+#   MSG91 → WhatsApp → Webhook (New) as a custom header on BOTH webhooks:
+#     X-Webhook-Secret: <this value>
+#   Inbound:  https://<api-domain>/api/v1/whatsapp/msg91/inbound  (On Inbound Request Received)
+#   Reports:  https://<api-domain>/api/v1/whatsapp/msg91/status   (On Outbound Report Received)
+# Test sends (Settings → WhatsApp) only go to WHATSAPP_TEST_ALLOWLIST and only
+# while WHATSAPP_SENDING_ENABLED=true. Campaigns never run through MSG91.
+MSG91_AUTH_KEY=
+MSG91_WHATSAPP_NUMBER=
+MSG91_WEBHOOK_SECRET=
+
 # ==========================================
 # WHATSAPP CAMPAIGNS (background worker)
 # ==========================================
@@ -128,3 +149,4 @@ SEED_ADMIN_PASSWORD=
 RATE_LIMIT_WINDOW_MINUTES=15
 RATE_LIMIT_MAX_REQUESTS=300
 PUBLIC_RATE_LIMIT_MAX_REQUESTS=60
+
